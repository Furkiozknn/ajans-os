{
  "//": "Yalnizca src/ arayuzlerini tip denetiminden gecirir. Uygulama kodu yok, cikti yok.",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.d.ts"]
}
